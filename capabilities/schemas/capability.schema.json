{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial.tres/capability.schema.v1",
  "title": "Editorial TR.ES Capability Declaration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "category",
    "invariants",
    "dependencies",
    "forbidden"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["editorial.tres/capability-v1"]
    },
    "id": {
      "type": "string",
      "pattern": "^editorial\\.[a-z0-9][a-z0-9.-]*$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "DECLARED",
        "CONTRACT_VALIDATED",
        "EXPERIMENTAL",
        "MEASURED",
        "DOMAIN_APPROVED",
        "RUNTIME_INTEGRATED",
        "CERTIFIED"
      ]
    },
    "category": {
      "type": "string",
      "enum": ["reviewer"]
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
