{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial.tres/acceptance.schema.v1",
  "title": "Editorial TR.ES Capability Acceptance Criteria",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability", "criteria"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["editorial.tres/acceptance-v1"]
    },
    "capability": {
      "type": "string",
      "pattern": "^editorial\\.[a-z0-9][a-z0-9.-]*$",
      "minLength": 3
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "observable", "required"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]*$",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "observable": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
